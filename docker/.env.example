# Copy to the project root as .env, next to docker-compose.yml. Never commit the real file.
APP_NAME=ECSO
APP_URL=https://banhang.example.vn
SANCTUM_STATEFUL_DOMAINS=banhang.example.vn
SESSION_SECURE_COOKIE=true
HTTP_PORT=8090

DB_DATABASE=ecso
DB_USERNAME=ecso
DB_PASSWORD=change-me-long-random
MYSQL_ROOT_PASSWORD=change-me-another-long-random
MYSQL_BUFFER_POOL=512M

# First super admin, created once by the init service (remove after the first start).
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=

MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=

# Shopee / TikTok Shop through EzChat: the EzChat address and the shared secret (= BANHANG_SECRET on EzChat).
EZCHAT_URL=
EZCHAT_SECRET=

BILLING_BANK_NAME=
BILLING_BANK_ACCOUNT_NUMBER=
BILLING_BANK_ACCOUNT_NAME=
BILLING_BANK_BRANCH=
PHP_FPM_MAX_CHILDREN=16
